---
import Layout from '../layouts/Layout.astro';
import IshikawaDiagram from '../components/IshikawaDiagram.astro';
---
<Layout title="OptimaTI - Diagnóstico">
    <div class="flex-1 max-w-4xl w-full mx-auto px-4 py-8 flex flex-col justify-center">
        
        <div id="capture-area" class="glass p-6 md:p-10 rounded-3xl relative overflow-hidden shadow-2xl border border-white/10 bg-primary/95">
            <!-- Decorative blur -->
            <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-accent/20 rounded-full blur-3xl pointer-events-none z-0"></div>
            
            <!-- Paso 0: Inicio -->
            <div id="step-0" class="step-container relative z-10 text-center animate-fade-in">
                <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-secondary/50 flex items-center justify-center border border-accent/40 text-sand shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M10.04 15.28a3 3 0 1 1-1.52-5.12 3 3 0 0 1 1.52 5.12z"/><path d="m11 14 3 3"/></svg>
                </div>
                <h2 class="text-3xl md:text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-light to-sand">
                    Diagnóstico de Incidentes
                </h2>
                <p class="text-base md:text-lg text-gray-300 mb-8 max-w-lg mx-auto">
                    Simula ser el Gestor Técnico. Analiza el síntoma y deduce la causa raíz para generar un ticket de acción basado en ITIL.
                </p>
                <button onclick="startRandomCase()" class="bg-accent hover:bg-accent/80 text-white font-semibold py-3 px-8 rounded-lg shadow-[0_0_15px_rgba(65,90,119,0.5)] transition-all transform hover:-translate-y-1">
                    Analizar Incidente Aleatorio
                </button>
            </div>

            <!-- Paso 1: Síntoma y Deducción -->
            <div id="step-1" class="step-container hidden relative z-10 animate-fade-in">
                <div class="flex justify-between items-end mb-6">
                    <div>
                        <div class="text-sm font-semibold text-accent mb-1">INCIDENTE DETECTADO</div>
                        <h3 id="ui-case-title" class="text-2xl font-bold text-sand"></h3>
                    </div>
                </div>
                
                <div class="bg-white/5 border border-white/10 rounded-xl p-5 mb-8">
                    <div class="text-sm text-gray-400 mb-2">Síntoma reportado por el cliente/usuario:</div>
                    <p id="ui-case-symptom" class="text-lg italic text-light leading-relaxed"></p>
                </div>

                <h4 class="font-bold mb-4">¿Cuál es la causa técnica de este problema?</h4>
                <div id="ui-case-options" class="grid gap-3">
                    <!-- Opciones inyectadas por JS -->
                </div>
            </div>

            <!-- Paso 2: Resultado (Reporte) -->
            <div id="step-2" class="step-container hidden relative z-10 animate-fade-in pb-10">
                <div class="flex items-center justify-between mb-6 border-b border-white/10 pb-4">
                    <div>
                        <div id="ui-ticket-id" class="text-sm font-mono text-accent"></div>
                        <h3 class="text-2xl font-bold text-white">Reporte de Análisis Raíz</h3>
                    </div>
                    <div class="bg-success/20 text-success border border-success/30 px-3 py-1 rounded-md text-sm font-bold flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        DIAGNOSTICADO
                    </div>
                </div>
                
                <div class="space-y-6">
                    <div class="bg-primary/50 p-4 rounded-xl border border-white/5">
                        <div class="text-sm text-gray-400 mb-1">Causa Raíz Identificada</div>
                        <div id="ui-res-causa" class="text-xl font-bold text-sand"></div>
                    </div>

                    <div>
                        <div class="text-sm text-gray-400 mb-1">Detalle del Hallazgo</div>
                        <p id="ui-res-hallazgo" class="text-lg bg-white/5 p-3 rounded-lg border border-white/5 text-gray-200"></p>
                    </div>

                    <div>
                        <div class="text-sm text-gray-400 mb-1">Plan de Acción Recomendado (Gestión Técnica)</div>
                        <p id="ui-res-accion" class="text-lg text-light leading-relaxed"></p>
                    </div>

                    <!-- Botón para ver Diagrama Ishikawa -->
                    <div class="pt-4 mt-6 border-t border-white/10 text-center">
                        <button onclick="openDiagramModal()" class="inline-flex items-center gap-2 bg-sand hover:bg-white text-primary font-bold py-2 px-6 rounded-lg transition-all shadow-[0_0_15px_rgba(212,196,168,0.4)] hover:shadow-[0_0_25px_rgba(212,196,168,0.7)]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/></svg>
                            Mostrar Mapa Analítico (Ishikawa)
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- Botones de Acción Post-Reporte (Fuera de la zona de captura para no imprimir en PDF) -->
        <div id="post-actions" class="hidden flex flex-wrap gap-4 mt-6 justify-center z-20 relative">
            <button onclick="goToStep(0)" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold py-2 px-6 rounded-lg transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                Analizar Nuevo Caso
            </button>
        </div>
    </div>

    <!-- Modal del Diagrama Ishikawa -->
    <div id="diagram-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-primary/90 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
        <div class="glass-card w-[95%] max-w-6xl rounded-3xl p-6 md:p-10 relative shadow-2xl border border-white/20 transform scale-95 transition-transform duration-300 flex flex-col" id="diagram-modal-content">
            
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-2xl md:text-3xl font-bold text-sand text-left">Arquetipo Sistémico de Causa y Efecto</h3>
                <div class="flex gap-2">
                    <button onclick="exportDiagram()" class="bg-accent/80 hover:bg-accent rounded-full p-2 text-white transition-colors flex items-center gap-2 px-4 shadow-lg text-sm font-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Exportar Diagrama
                    </button>
                    <button onclick="closeDiagramModal()" class="bg-white/10 hover:bg-white/20 rounded-full p-2 text-white transition-colors shadow-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
            </div>
            
            <p class="text-left text-gray-400 mb-6">El área resaltada indica la causa raíz diagnosticada en el incidente actual.</p>
            
            <div class="flex-1 w-full bg-primary/50 rounded-2xl overflow-x-auto custom-scroll shadow-inner">
                <div class="min-w-[900px] p-4">
                    <IshikawaDiagram />
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import { getCases, saveTicket } from '/src/scripts/store.js';
        import * as htmlToImage from 'html-to-image';
        
        let currentCase = null;
        let cases = [];

        window.goToStep = (step) => {
            document.querySelectorAll('.step-container').forEach(el => el.classList.add('hidden'));
            document.getElementById(`step-${step}`).classList.remove('hidden');
            
            if(step !== 2) {
                document.getElementById('post-actions').classList.add('hidden');
            }
        };

        window.openDiagramModal = () => {
            const modal = document.getElementById('diagram-modal');
            const content = document.getElementById('diagram-modal-content');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        };

        window.closeDiagramModal = () => {
            const modal = document.getElementById('diagram-modal');
            const content = document.getElementById('diagram-modal-content');
            modal.classList.add('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
        };

        window.selectOption = (optionObj) => {
            const ticketId = `TKT-${Math.floor(Math.random()*90000) + 10000}`;
            
            document.getElementById('ui-ticket-id').textContent = ticketId;
            document.getElementById('ui-res-causa').textContent = optionObj.category;
            document.getElementById('ui-res-hallazgo').textContent = optionObj.detail;
            document.getElementById('ui-res-accion').textContent = optionObj.action;
            
            // Highlight Ishikawa branch
            const line = document.getElementById(`svg-branch-${optionObj.category}`);
            const box = document.getElementById(`box-${optionObj.category}`);
            if(line && box) {
                line.classList.add('ishikawa-line-active');
                box.classList.add('ishikawa-box-active');
            }

            // Save to history
            const ticketRecord = {
                id: ticketId,
                date: new Date().toLocaleDateString(),
                title: currentCase.title,
                category: optionObj.category,
                detail: optionObj.detail
            };
            saveTicket(ticketRecord);

            goToStep(2);
            setTimeout(() => {
                document.getElementById('post-actions').classList.remove('hidden');
            }, 500);
        };

        window.startRandomCase = () => {
            cases = getCases();
            if(cases.length === 0) return;
            const randomIndex = Math.floor(Math.random() * cases.length);
            currentCase = cases[randomIndex];
            
            document.getElementById('ui-case-title').textContent = currentCase.title;
            document.getElementById('ui-case-symptom').textContent = currentCase.symptom;
            
            // Randomize options order
            const options = [...currentCase.options].sort(() => Math.random() - 0.5);
            const optionsContainer = document.getElementById('ui-case-options');
            optionsContainer.innerHTML = '';
            
            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl glass-card hover:bg-white/10 transition-colors border border-white/5 flex gap-3 group";
                btn.onclick = () => window.selectOption(opt);
                btn.innerHTML = `
                    <div class="mt-1 text-accent group-hover:scale-110 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                    <div>${opt.text}</div>
                `;
                optionsContainer.appendChild(btn);
            });
            
            // Limpiar Ishikawa visual
            document.querySelectorAll('.ishikawa-line-active').forEach(el => el.classList.remove('ishikawa-line-active'));
            document.querySelectorAll('.ishikawa-box-active').forEach(el => el.classList.remove('ishikawa-box-active'));

            goToStep(1);
        };

        window.downloadReport = async () => {
            try {
                const captureEl = document.getElementById('capture-area');
                
                const dataUrl = await htmlToImage.toPng(captureEl, {
                    backgroundColor: '#0D1B2A',
                    pixelRatio: 2
                });
                
                const link = document.createElement('a');
                link.download = `Reporte_${document.getElementById('ui-ticket-id').textContent}.png`;
                link.href = dataUrl;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (err) {
                console.error("Error al exportar PNG:", err);
                alert("Hubo un error al generar la imagen. Revisa la consola.");
            }
        };

        window.exportDiagram = async () => {
            try {
                // Selecciona el área específica del diagrama
                const captureEl = document.getElementById('ishikawa-export-area');
                
                const dataUrl = await htmlToImage.toPng(captureEl, {
                    backgroundColor: '#0D1B2A',
                    pixelRatio: 3 // Mayor calidad para el diagrama
                });
                
                const link = document.createElement('a');
                link.download = `Diagrama_Ishikawa_${document.getElementById('ui-ticket-id').textContent}.png`;
                link.href = dataUrl;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (err) {
                console.error("Error al exportar Diagrama:", err);
                alert("Hubo un error al generar la imagen del diagrama.");
            }
        };
    </script>
</Layout>
